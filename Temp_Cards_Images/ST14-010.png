<script>
	var screenWidth;
	var screenHeight;
	var screenRatio;
	
	function resize(){
		screenWidth = window.innerWidth;
		screenHeight = window.innerHeight;
		screenRatio = screenWidth / screenHeight;
		
		if(screenRatio < 1){
			$('.holder').removeClass('holder2').removeClass('holder3').addClass('holder1');
		}
		else if(screenRatio <= 20/9){
			$('.holder').removeClass('holder1').removeClass('holder3').addClass('holder2');
		}
		else if(screenRatio > 20/9){
			$('.holder').removeClass('holder1').removeClass('holder2').addClass('holder3');
		}
	}
	
	resize();
	window.onresize = resize;	
</script>

